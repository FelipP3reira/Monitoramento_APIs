{
  "name": "monitoramento-apis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --experimental-transform-types --disable-warning=ExperimentalWarning --env-file=.env --watch src/principal.ts",
    "worker": "node --experimental-transform-types --disable-warning=ExperimentalWarning --env-file=.env src/agendador/principal.ts",
    "migrar": "node --experimental-transform-types --disable-warning=ExperimentalWarning --env-file=.env src/db/migrar.ts",
    "tipos": "tsc --noEmit",
    "lint": "eslint .",
    "formatar": "prettier --write .",
    "formato": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "kysely": "^0.29.5",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
