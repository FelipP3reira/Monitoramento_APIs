# Conexao com o Postgres do docker-compose.
DATABASE_URL=postgres://monitoramento:monitoramento@localhost:5441/monitoramento

PORTA=3011
AMBIENTE=desenvolvimento

# Token exigido no cabecalho Authorization: Bearer de todas as rotas /api.
# Gere o seu com: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
API_TOKEN=troque-por-um-token-longo-e-aleatorio

# Chave de 32 bytes em hex usada para cifrar cabecalhos e segredos dos monitores.
# Gere a sua com: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CHAVE_CIFRA=troque-por-64-caracteres-hexadecimais

# Quantos monitores cada ciclo do worker reserva de uma vez.
LOTE_DO_WORKER=10
# Por quanto tempo um monitor reservado fica travado antes de voltar para a fila.
LEASE_SEGUNDOS=60
# Dias de resultado cru mantidos antes da retencao apagar (o agregado horario fica).
RETENCAO_DIAS=30

# SMTP e opcional: sem host, o canal de e-mail usa um transporte falso em memoria.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=alertas@monitoramento.local
